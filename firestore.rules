rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          "muhammadsaad16321@gmail.com"
        ];
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["applicationCount", "updatedAt"]) &&
        request.resource.data.applicationCount >= (resource.data.applicationCount ?? 0)
      );
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}